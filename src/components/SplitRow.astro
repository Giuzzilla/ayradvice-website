---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	title: string;
	image: ImageMetadata;
	alt: string;
	imageFirst?: boolean;
}

const { title, image, alt, imageFirst = false } = Astro.props;
---

<div class="split-row">
	{imageFirst && (
		<div class="split">
			<Image src={image} sizes="(max-width: 991px) 92vw, 432px" alt={alt} class="split-image" />
		</div>
	)}
	<div class="split">
		<h2 class="split-title">{title}</h2>
		<p class="split-text">
			<slot />
		</p>
	</div>
	{!imageFirst && (
		<div class="split">
			<Image src={image} sizes="(max-width: 991px) 92vw, 432px" alt={alt} class="split-image" />
		</div>
	)}
</div>

<style>
	.split-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 940px;
		margin: 0 auto;
	}

	.split {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 46%;
	}

	.split-title {
		margin-top: 20px;
		margin-bottom: 15px;
		font-size: 44px;
		line-height: 62px;
	}

	.split-text {
		margin-bottom: 24px;
	}

	.split-image {
		border-radius: 20px;
		box-shadow: 0 4px 24px rgba(150, 163, 181, 0.08);
	}

	@media screen and (max-width: 991px) {
		.split-row {
			flex-direction: column;
			align-items: flex-start;
			max-width: 728px;
			margin-bottom: -40px;
		}

		.split {
			max-width: 100%;
			margin-bottom: 40px;
		}
	}

	@media screen and (max-width: 479px) {
		.split-row {
			max-width: none;
		}

		.split-title {
			font-size: 36px;
			line-height: 52px;
		}
	}
</style>
