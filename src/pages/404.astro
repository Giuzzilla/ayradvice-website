---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="Pagina non trovata | AYR Advice di Marco Mazzanti">
	<section class="not-found">
		<h1 class="heading-jumbo-small">Pagina non trovata</h1>
		<p class="text-light">La pagina che hai cercato non esiste o è stata spostata</p>
		<Button href="/">Torna alla homepage</Button>
	</section>
</Base>

<style>
	.not-found {
		padding: 120px 30px;
		text-align: center;
	}
</style>
