{
	"name": "ayradvice-website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build --mode development && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types worker/worker-configuration.d.ts",
		"check": "astro sync && wrangler types worker/worker-configuration.d.ts && tsc --noEmit --runExternalCode && tsc -p worker && oxlint && oxfmt --check",
		"format": "oxfmt",
		"lint": "oxlint"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"astro": "^7.4.7"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "^0.5.2",
		"@astrojs/ts-content-mapper": "^0.2.0",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"typescript": "7.1.0-beta",
		"wrangler": "4.158.0"
	}
}
